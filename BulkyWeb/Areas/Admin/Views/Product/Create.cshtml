@model ProductVM

<div class ="card shadow border-0 my-5">
    <div class="card-header bg-secondary bg-blackbg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">
                    Create Product
                </h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">

            <div class="container">

                <div class="mt-4">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
                <div class="pt-2 pb-2 row">
                    <label asp-for="Product.Title"></label>
                    <input asp-for="Product.Title" class="form-control" />
                    <span asp-validation-for="Product.Title"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.Author"></label>
                    <input asp-for="Product.Author" class="form-control" />
                    <span asp-validation-for="Product.Author"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="@Model.Product.Description"></label>
                    <textarea asp-for="Product.Description" class="form-control"></textarea>
                    <span asp-validation-for="Product.Description"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.ISBN"></label>
                    <input asp-for="Product.ISBN" class="form-control" />
                    <span asp-validation-for="Product.ISBN"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.ListPrice"></label>
                    <input asp-for="Product.ListPrice" class="form-control" />
                    <span asp-validation-for="Product.ListPrice"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.Price"></label>
                    <input asp-for="Product.Price" class="form-control" />
                    <span asp-validation-for="Product.Price"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.Price50"></label>
                    <input asp-for="Product.Price50" class="form-control" />
                    <span asp-validation-for="Product.Price50"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.Price100"></label>
                    <input asp-for="Product.Price100" class="form-control" />
                    <span asp-validation-for="Product.Price100"></span>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.Category"></label>
                    <select asp-for="Product.Category" asp-items="@Model.CategoryList" class="form-select">
                        <option disabled selected>--Select Category--</option>
                    </select>
                </div>
                <div class="row pt-2 pb-2">
                    <label asp-for="Product.ImageUrl"></label>
                    <input asp-for="Product.ImageUrl" class="form-control" />
                    <span asp-validation-for="Product.ImageUrl"></span>
                </div>
                <div class="row p-2 ">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">Create</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Product" asp-action="Index" class=" btn btn-outline-secondary border form-control"> Back</a>
                    </div>
                </div>
                @*Direct way to add partial scripts if they are small or view releated (not script releated)*@
                @* <partial name="_ValidationScriptsPartial" /> *@
            </div>
        </form>
    </div>
</div>



@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
