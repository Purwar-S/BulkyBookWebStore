@model IEnumerable<Product>

<div class="container">
    <div class="row pt-4 pb-3">

        <div class="col-6 text-start">
            <h2 class="text-primary">
                Products List
             </h2>
        </div>
        <div class="col col-6 text-end">
            <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Product
            </a>
        </div>
    </div>
<table class="table table-bordered table-hover table-striped">
    <thead>
        <th>Product Name</th>
        <th>ISBN</th>
        <th>Price</th>
        <th>Author</th>
        <th>Category</th>
    </thead>
    <tbody>
        @foreach(var i in Model.OrderBy(u => u.Id)){
            <tr>
                <td>
                    @i.Title
                </td>
                <td>
                    @i.ISBN
                </td>
                <td>
                    @i.ListPrice
                </td>
                <td>
                    @i.Author
                </td>
                <td>
                    @i.Id
                </td>
                <td>
                    <div class="btn-group w-75" role="group">
                        <a asp-controller="Product" asp-action="Edit" asp-route-Id="@i.Id" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i> Edit
                        </a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-Id="@i.Id" class="btn btn-danger mx-2">
                                <i class="bi bi-trash3"></i> Delete
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>


</table>
</div>