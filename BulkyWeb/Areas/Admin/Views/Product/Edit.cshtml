@model Product

<div class="container my-5">
<form method="post">
    <input asp-for="Id" hidden />
    <div class="container">

        <div class="mt-4 mb-3">
            <div asp-validation-summary="ModelOnly"></div>
            <h2 class="text-primary">
                Edit Product
            </h2>
        </div>
        <div class="mt-4">
            <div asp-validation-summary="ModelOnly"></div>
        </div>
        <div class="pt-2 pb-2 row">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="Author"></label>
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="ISBN"></label>
            <input asp-for="ISBN" class="form-control" />
            <span asp-validation-for="ISBN"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="ListPrice"></label>
            <input asp-for="ListPrice" class="form-control" />
            <span asp-validation-for="ListPrice"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="Price"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="Price50"></label>
            <input asp-for="Price50" class="form-control" />
            <span asp-validation-for="Price50"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="Price100"></label>
            <input asp-for="Price100" class="form-control" />
            <span asp-validation-for="Price100"></span>
        </div>
        <div class="row pt-2 pb-2">
            <label asp-for="CategoryId"></label>
            <select asp-for="CategoryId" asp-items="ViewBag.CategoriesList" class="form-select border-0 shadow">
                <option disabled selected>--Select Category--</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        @* <div class="row pt-2 pb-2">
            <label asp-for="ImageUrl"></label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl"></span>
        </div> *@
        <div class="row p-2 ">
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary form-control">
                    Update
                </button>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Product" asp-action="Index" class=" btn btn-outline-secondary border form-control"> 
                    Back
                </a>
            </div>
        </div>
        @*Direct way to add partial scripts f they are smal or view releated (not script releated)*@
        @* <partial name="_ValidationScriptsPartial" /> *@
    </div>
</form>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
